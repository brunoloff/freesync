{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeSync",
  "version": "0.1.0",
  "identifier": "io.github.brunoloff.freesync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main", "title":"FreeSync", "width":1100, "height":760, "minWidth":620, "minHeight":520}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {"active":false, "targets":"all", "category":"Utility", "shortDescription":"Local-first desktop file synchronization"}
}
